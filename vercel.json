{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/mcp.ts", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 256 } },
    { "src": "api/search-saiketsu.ts", "use": "@vercel/node", "config": { "maxDuration": 60, "memory": 256 } },
    { "src": "api/get-law.ts", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 256 } },
    { "src": "api/get-law-history.ts", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 256 } },
    { "src": "api/search-law.ts", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 256 } },
    { "src": "api/get-tsutatsu.ts", "use": "@vercel/node", "config": { "maxDuration": 60, "memory": 256 } },
    { "src": "api/list-tsutatsu.ts", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 256 } },
    { "src": "api/list-saiketsu.ts", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 256 } },
    { "src": "api/get-saiketsu.ts", "use": "@vercel/node", "config": { "maxDuration": 60, "memory": 256 } }
  ],
  "routes": [
    { "src": "/mcp", "dest": "/api/mcp.ts" }
  ]
}
